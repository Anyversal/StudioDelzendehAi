rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Privileged role claims must be assigned only by trusted server code using
    // the Firebase Admin SDK. A client-editable profile is never an authority.
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isAccountant() {
      return isOwner() || hasRole('accountant');
    }

    match /users/{userId} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isOwner() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'member')
      );
      // A user can edit their own profile fields, but never their role.
      allow update: if isOwner() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isOwner();
    }

    match /development_fund/{entryId} {
      allow read: if isAccountant();
      allow create: if isAccountant();
      allow update: if isOwner();
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Connection checks are no longer public. Only authenticated clients can
    // read, and only the owner claim can write test documents.
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Deny every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
